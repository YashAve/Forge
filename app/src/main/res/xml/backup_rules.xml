<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for API <= 30 (API 31+ uses data_extraction_rules.xml).
   The preferences DataStore holds the auth token and onboarding flag; restoring it
   on a reinstall skips onboarding/login and lands on Home with a stale session.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/forge_preferences.preferences_pb" />
</full-backup-content>
